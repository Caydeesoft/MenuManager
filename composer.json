{
    "name": "caydeesoft/menu-manager",
    "description": "Config-driven Laravel menu manager for Blade sidebar navigation, top menus, dropdowns, and permission-aware links.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laravel-menu",
        "menu-manager",
        "sidebar",
        "navigation",
        "blade",
        "dropdown-menu",
        "permission",
        "spatie-permission",
        "admin-panel"
    ],
    "homepage": "https://github.com/caydeesoft/menu-manager",
    "support": {
        "issues": "https://github.com/caydeesoft/menu-manager/issues",
        "source": "https://github.com/caydeesoft/menu-manager"
    },
    "autoload": {
        "psr-4": {
            "Caydeesoft\\MenuManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Caydeesoft\\MenuManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Caydeesoft\\MenuManager\\Providers\\MenuManagerServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Dennis Kiptoo Kiptugen",
            "email": "dennis.kiptugen@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"

    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
